# ==============================================================================
# ExamPilote Environment Configuration Template
# Copy this file to `backend/.env` (and optionally `.env` at root) and fill in your actual settings.
# NEVER commit your actual `.env` file to version control.
# ==============================================================================

# Database Settings (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=exampilote

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:5500

# AI Provider Settings (Options: mock, gemini, openai)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Generation Settings
MAX_QUESTIONS_PER_REQUEST=20
DEFAULT_QUESTION_COUNT=5
DEFAULT_DIFFICULTY=Medium
DEFAULT_FORMAT=Single-correct MCQ

# Document Upload Limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=.txt,.pdf,.docx
